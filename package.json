{
  "name": "@huakira/tool-call-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Supplemental guard for DSH: recover from rejected tool calls, keep a per-turn step budget, and warn when a known-fragile model is selected.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huakira/dsh-tool-call-guard.git"
  },
  "author": {
    "name": "Huakira",
    "email": "huakexie@proton.me"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ]
}
